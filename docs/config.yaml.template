# Fileglancer server configuration
#
# Every setting here is optional and shown at its default (or as an example
# where there is no default), so an empty file is a valid config. Settings
# can also be given as environment variables with an FGC_ prefix
# (FGC_LOG_LEVEL, FGC_CLUSTER__EXECUTOR for nested ones); those take
# precedence over this file.
#
# Where the file lives:
#   - `fileglancer start` (personal server) reads
#     ~/.config/fileglancer/config.yaml, creating a commented default on
#     first run, and logs the path it read. --config PATH or FGC_CONFIG_FILE
#     picks another file.
#   - A server started with uvicorn directly reads ./config.yaml from the
#     current directory unless FGC_CONFIG_FILE says otherwise.
#   - A .env file next to the config is read for FGC_* variables.

###############################################################################
# Who is this server for?
#
# Fileglancer runs in one of two modes, and these settings pick it:
#
#                       single-user (default)        multi-user
#   enable_okta_auth    false                        true
#   use_access_flags    false                        true (run as root)
#   login               simple_auth_password         Okta
#   runs as             the process's own user       each logged-in user
#   cluster.executor    local or lsf                 lsf
#
# Single-user is what the `fileglancer` CLI and local development use:
# every request runs as the OS user who started the server, and the login
# page asks for one password. Multi-user requires Okta, because acting as
# other users is only safe when an identity provider vouches for who is
# asking. There is deliberately no multi-user mode with password login.
# Mixing the columns (setuid workers without Okta, or with the local
# executor) is refused at startup.
###############################################################################

#
# Require Okta login. When false the server is single-user.
#
# enable_okta_auth: false

#
# Run each user's file access in a worker that switches to that user's OS
# identity. Requires enable_okta_auth, running as root, and a real scheduler
# (cluster.executor: lsf).
#
# use_access_flags: false

#
# Password for the single-user login page. When unset, a random one is
# generated at startup and printed to the server log. Set it when running
# more than one worker process, since each worker would otherwise print its
# own.
#
# simple_auth_password: change-me

###############################################################################
# Logging
###############################################################################

#
# Loguru logging level (ERROR, WARNING, INFO, DEBUG, TRACE)
#
# log_level: INFO

#
# Log output format: 'text' for human-readable logs, or 'json' for one
# ECS-shaped JSON object per line on stdout, ready for a log shipper to
# forward to Elasticsearch/Kibana. See docs/StructuredLogging.md.
#
# log_format: text

###############################################################################
# Database
###############################################################################

#
# Database URL (runtime - unprivileged user). The default is a SQLite file in
# the current directory; the `fileglancer` CLI uses
# ~/.local/share/fileglancer/fileglancer.db instead. Use an absolute path for
# SQLite (four slashes) so it does not depend on where the server starts.
#
# db_url: sqlite:////var/lib/fileglancer/fileglancer.db
# db_url: postgresql://username:password@hostname:port/database_name

#
# Database admin URL (migrations - privileged user)
# If not specified, db_url will be used for migrations
#
# db_admin_url: postgresql://admin_user:admin_password@localhost/fileglancer

#
# Database connection pool settings (applies to non-SQLite databases)
#
# db_pool_size: 5          # Number of connections to keep in the pool
# db_max_overflow: 0       # Number of additional connections allowed beyond pool_size

###############################################################################
# Files and data links
###############################################################################

#
# File share mount paths to view in the UI. Defaults to the user's home
# directory. Set to an empty list to use the file share paths stored in the
# database instead.
#
# file_share_mounts:
#   - "~/"
#   - /tmp

#
# Public base URL of the /files/ data-link proxy. Unset, data links use the
# URL the request arrived on, which is right whenever this server serves
# /files/ itself. Set it only when data links are served from a different
# host than the UI.
#
# external_proxy_url: https://data.example.org/files

#
# Maximum size in bytes accepted by a PUT /api/content upload. Guards the
# streaming write path against an unbounded upload filling the disk. Set to 0
# to disable the limit. Default is 50 GiB.
#
# max_upload_size_bytes: 53687091200

#
# Maximum size of the sharing key LRU cache. Higher values use more memory
# but reduce database queries.
#
# sharing_key_cache_size: 1000

###############################################################################
# Viewers
###############################################################################

#
# Absolute path to a viewers config YAML that overrides the bundled default
# (frontend/src/config/viewers.config.yaml) at runtime, without a rebuild.
# Restart the server after editing it. See docs/ViewersConfiguration.md.
#
# viewers_config: /opt/deploy/viewers.config.yaml

#
# Dev-only: pass /neuroglancer/* through to this Neuroglancer so the embedded
# viewer is same-origin and View editing can be tested locally (see
# docs/Development.md).
#
# neuroglancer_url: https://neuroglancer.example.org

###############################################################################
# Okta (multi-user mode)
###############################################################################

#
# OKTA domain (e.g., your-domain.okta.com)
#
# okta_domain: your-domain.okta.com

#
# OKTA OAuth application client ID
#
# okta_client_id: your_client_id

#
# OKTA OAuth application client secret
# IMPORTANT: Keep this secret! Consider using environment variables instead
#
# okta_client_secret: your_client_secret

#
# OKTA OAuth redirect URI (callback URL)
# This must match the redirect URI configured in your OKTA application
#
# okta_redirect_uri: https://<your_domain>/api/oauth_callback

###############################################################################
# Sessions
###############################################################################

#
# Secret key for signing session cookies. If not set, a random key is
# generated at each server start, so sessions do not survive restarts and
# worker processes disagree with each other. Set it for any deployment with
# more than one worker. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (The `fileglancer` CLI generates and keeps one for you.)
#
# session_secret_key: your-generated-secret-key-here

#
# Session expiry time in hours
#
# session_expiry_hours: 24

#
# Name of the session cookie
#
# session_cookie_name: fg_session

#
# Secure flag on the session cookie. Unset, the cookie is Secure exactly when
# the login request arrived over https, so plain-http development and https
# deployments both work. Set it explicitly only behind a TLS-terminating
# proxy that does not forward the scheme (X-Forwarded-Proto).
#
# session_cookie_secure: true

###############################################################################
# Programmatic API
###############################################################################

#
# Cross-origin allowlist. Browser apps on other origins (subdomains/ports
# under the same base domain) that may call the authenticated Fileglancer API
# using the logged-in user's session cookie. List full origins (scheme + host
# + optional port). The Fileglancer UI's own origin is always allowed and
# need not be listed. Requests carrying an Origin header not in this list are
# rejected with 403 on authenticated endpoints — this is the CSRF /
# cross-site boundary. Empty (default) means only same-origin calls work.
# See docs/ProgrammaticAPI.md.
#
# api_allowed_origins:
#   - https://other-app.example.org
#   - https://pipelines.example.org:8444

#
# Which API token scopes this server supports. A scope left out cannot be
# granted to a new token, and is ignored on tokens that already hold it -- so
# removing one here revokes the capability from existing tokens rather than
# only affecting new ones.
#
# files:write and jobs:write are absent from the default shown below because
# both amount to full access to the user's files: jobs:write runs arbitrary
# code as the user, so it reaches every file regardless of the files:* scopes
# granted. Enable them per server, deliberately.
#
# api_token_scopes:
#   - files:read
#   - files:write
#   - links:read
#   - links:write
#   - jobs:read
#   - jobs:write

###############################################################################
# JIRA (Help menu tickets)
###############################################################################

#
# Atlassian Cloud info. Used for retrieving JIRA tickets.
#
# atlassian_url: https://YOUR_ORG_ID.atlassian.net
# atlassian_username: your_email@example.com
# atlassian_token: your_api_token

#
# JIRA browse URL for constructing ticket links
# If not specified, defaults to {atlassian_url}/browse
#
# jira_browse_url: https://YOUR_ORG_ID.atlassian.net/browse

###############################################################################
# Apps and jobs
###############################################################################

#
# Environment setup — sourced at startup before any scheduler commands.
# Useful when running as a systemd service where login scripts don't run.
#
# env_source_script: /opt/lsf/conf/profile.lsf  # Source a shell script to set env vars

#
# Settings for the Apps feature
#
# apps:
#   extra_paths:                # Paths appended to $PATH in every job script
#     - /opt/nextflow/bin       # and used when verifying tool requirements
#     - /opt/pixi/bin
#   worker_env_passthrough:     # Extra env var names (exact) or prefixes
#     - MYSITE_LICENSE_SERVER   # (ending in '_') to pass to per-user workers,
#     - MYSITE_                 # on top of the built-in allowlist. The worker
#                               # env is an allowlist so no server secret leaks
#                               # to the user; add only non-secret vars your
#                               # scheduler or tools need. FGC_* is never passed.
#   unknown_timeout_hours: 24    # Give up polling a job stuck in UNKNOWN after
#                               # this many hours and mark it FAILED (the
#                               # scheduler can no longer report it). 0 disables.
#   service_proxy_domain: services.example.org
#                               # Wildcard DNS zone serving per-job HTTPS
#                               # subdomains for running services. When set, a
#                               # service is published at
#                               # https://job-<id>-<mac>.<zone>/ instead of its
#                               # own http://<node>:<port>/ URL. Needs a wildcard
#                               # certificate for the zone, a reverse proxy
#                               # resolving upstreams via /api/apps/resolve, and
#                               # session_secret_key (which signs the hostname);
#                               # see docs/ServiceProxy.md. Empty = direct URL.
#   service_proxy_upstream_zone: nodes.example.org
#                               # DNS zone the proxy is allowed to dial, i.e.
#                               # where your compute nodes live. A service
#                               # publishes its own upstream, so this confines
#                               # where that can point. Matched on whole DNS
#                               # labels, so a leading dot is optional and
#                               # evil-nodes.example.org does not qualify.
#                               # Hostnames only: a node that publishes its IP
#                               # is still accepted. Empty = no restriction.
#   service_proxy_upstream_networks:
#     - 10.20.0.0/16            # CIDR networks the proxy is allowed to dial.
#                               # The companion to the zone above: that confines
#                               # upstreams published as hostnames, this confines
#                               # upstreams published as IP addresses, since a
#                               # bare address has no zone to match. Empty = no
#                               # restriction. Loopback, link-local and the other
#                               # host-local ranges are refused either way.

#
# Settings for Cloud Storage (user-added public S3 buckets)
#
# cloud_storage:
#   enabled: true               # Show the Cloud Storage section and allow users
#                               # to add buckets.
#   allowed_endpoints:          # Which S3 endpoints users may add. Unset: any
#     - https://s3.example.org  # https endpoint that resolves to public address
#                               # space. Empty list ([]): AWS only. A list of
#                               # https origins: only those.

#
# Cluster configuration
# Mirrors py-cluster-api ClusterConfig - all fields are optional
# See: https://github.com/JaneliaSciComp/py-cluster-api
#
# cluster:
#   executor: local            # "local" or "lsf". "local" is for single-user
#                              # deployments (dev, CLI mode) only: its poll loop
#                              # reads job state from the work directory in the
#                              # server process, and work directories are private
#                              # to the user who owns the job. A multi-user
#                              # deployment must use "lsf".
#   job_name_prefix: fg        # Prefix for cluster job names. REQUIRED for job
#                              # reconnection after server restarts. Without this,
#                              # active jobs will not be re-tracked and will
#                              # eventually be marked FAILED by the zombie timeout.
#   memory: "8 GB"             # Default memory allocation
#   walltime: "04:00"          # Default walltime (HH:MM)
#   cpus: 1                    # Default CPU count
#   queue: normal              # LSF queue name
#   poll_interval: 10.0        # Job status polling interval (seconds)
#   lsf_units: MB              # Memory units for LSF (KB, MB, GB)
#   suppress_job_email: true    # Suppress LSF job email notifications
#   extra_directives:           # Additional scheduler directives (prefix auto-added)
#     - "-P your_account"
#   extra_args:                 # Extra CLI args appended to submit command
#     - "-P"
#     - "your_project"
#   script_prologue:            # Commands to run before each job
#     - "module load java/11"
